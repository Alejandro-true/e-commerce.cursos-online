# Base PostgreSQL de Community Service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=comunidad_db
DB_USER=comunidad_user
DB_PASSWORD="CAMBIA_ESTA_CONTRASENA"

# Solo para desarrollo local: la API acepta X-Student-Id y X-Admin-Id.
# En produccion, integra el proveedor de identidad aprobado por el equipo.
AUTH_MODE=development

# Comunicación con Catalog Service
CATALOG_SERVICE_URL=http://localhost:8080
SERVICE_API_KEY=CAMBIA_ESTA_CLAVE_COMPARTIDA_DE_32_CARACTERES

# RabbitMQ para el evento ModuloCompletado emitido por Progress Service
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=aulabreve.domain.events
RABBITMQ_QUEUE=community.modulo-completado

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
