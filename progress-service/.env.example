PORT=3000
MONGODB_URI=mongodb://localhost:27017/progresoDB
NODE_ENV=development
AUTH_MODE=development
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Identity provider (OIDC/JWKS); protected API rejects requests until configured
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=aulabreve

# Catalog Service REST contract
CATALOGO_SERVICE_URL=http://localhost:8080
CATALOGO_ACCESS_PATH=/api/internal/progreso/cursos/{idCurso}/acceso/{idUsuario}
CATALOGO_STRUCTURE_PATH=/api/internal/progreso/cursos/{idCurso}/versiones/{versionCurso}
SERVICE_API_KEY=local-development-service-key-change-this-32chars

# RabbitMQ; Progress declares the durable community queue and publishes via outbox
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=aulabreve.domain.events
